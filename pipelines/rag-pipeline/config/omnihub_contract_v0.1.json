{
  "contractName": "OmniHub DocRecord Standard",
  "version": "0.1.0",
  "description": "OmniHub 회계법인 AI 검색 및 RAG 시스템을 위한 문서 스키마 정의",
  "schema": {
    "required_fields": [
      "fileId",
      "title",
      "content",
      "securityLevel",
      "department",
      "docStatus",
      "createdAt"
    ],
    "enums": {
      "securityLevel": ["high", "medium", "low"],
      "docStatus": ["pending", "approved", "rejected"],
      "source": ["upload", "google_drive", "local"]
    },
    "id_rules": {
      "fileId_prefix": "fil_",
      "eventId_prefix": "evt_",
      "traceId_prefix": "trace_"
    },
    "business_rules": {
      "security_high_keywords": ["대외비", "기밀", "계약서", "주민등록번호", "비밀", "Confidential"],
      "security_low_keywords": ["공지", "보도자료", "뉴스", "안내", "식단표"],
      "departments": ["Tax", "Audit", "Consulting", "Finance", "HR", "General"]
    }
  }
}