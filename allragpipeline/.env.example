# ==========================================
# 1. GCP 기본 설정 (Core Project Settings)
# ==========================================
GCP_PROJECT_ID=your-project-id
# 서비스 계정 키 파일 경로 (로컬 실행 시 필수)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# 기본 리전 (Vertex AI 등 서비스 위치)
VERTEX_LOCATION=us-central1
LOG_LEVEL=INFO

# ==========================================
# 2. 데이터 스토리지 (Storage & Database)
# ==========================================
# Firestore 데이터베이스 이름 (기본값: (default))
FIRESTORE_DATABASE=(default)

# GCS 버킷 및 접두어 (문서 원본 및 파이프라인 산출물 저장소)
GCS_BUCKET=your-bucket-name
GCS_PREFIX=omnihub-data

# ==========================================
# 3. 테넌트 및 범위 (Tenant & Scope)
# ==========================================
# 파이프라인/API 실행 시 기본 적용할 격리 범위 (운영 최소 단위)
TENANT_ID=my-tenant
ENGAGEMENT_ID=eng-001

# ==========================================
# 4. 데이터 수집 (Ingestion - Drive & DocAI)
# ==========================================
# 구글 드라이브 동기화 루트 폴더 ID
DRIVE_ROOT_FOLDER_ID=your-root-folder-id
# 인증 모드: sa (Service Account), dwd (Domain-Wide Delegation), oauth
DRIVE_OAUTH_MODE=sa

# Document AI (OCR) 설정
DOC_AI_LOCATION=us
DOC_AI_PROCESSOR_ID_PDF=your-pdf-processor-id
DOC_AI_PROCESSOR_ID_IMAGE=your-image-processor-id

# 텍스트 청킹 설정
CHUNK_SIZE_HINT=1000
CHUNK_OVERLAP_HINT=200

# ==========================================
# 5. 생성형 AI (LLM & Embedding)
# ==========================================
LLM_PROVIDER=vertex
# 요약 및 생성에 사용할 Gemini 모델
VERTEX_MODEL_NAME="gemini-2.5-flash"
# 임베딩 모델
EMBEDDING_PROVIDER=vertex
VERTEX_EMBED_MODEL=text-embedding-004

# 프롬프트 버전 관리
SUMMARY_PROMPT_VERSION=v1
GENERATOR_PROMPT_VERSION=v1
ENTITY_EXTRACTOR_VERSION=v1

# ==========================================
# 6. 벡터 검색 (Vector Search)
# ==========================================
# Vertex AI Vector Search 인덱스 설정
VECTOR_INDEX_NAME=projects/your-project-id/locations/us-central1/indexes/your-index-id
VECTOR_INDEX_ENDPOINT=projects/your-project-id/locations/us-central1/indexEndpoints/your-endpoint-id
VECTOR_DEPLOYED_INDEX_ID=your_deployed_index_id

VECTOR_DIM=768
VECTOR_UPSERT_BATCH_SIZE=100

# ==========================================
# 7. 파이프라인 설정 (Pipeline Runner)
# ==========================================
PIPELINE_VERSION=v0.1
PIPELINE_RUNNER_VERSION=v1
PIPELINE_MAX_RETRIES=0

# 정책 및 규칙 버전
POLICY_RULE_VERSION=v1
CONCEPT_RULES_VERSION=v1
EDGE_RANKER_VERSION=v1
GRAPH_SERVING_INDEX_VERSION=v1

# 그래프 구축 제한 설정
TOP_CONCEPTS_CAP=50
PER_DOC_CAP=50
PER_NODE_CAP=50

# ==========================================
# 8. API 서버 설정 (Server & Security)
# ==========================================
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 인증 및 보안
AUTH_MODE=header
PERMISSION_POLICY_VERSION=v1
RATE_LIMIT_MODE=firestore
RATE_LIMIT_WINDOW_SEC=60

# 보안 다운로드 (Signed URL) 설정
DOWNLOAD_URL_EXPIRES_SEC=300
SIGNED_URL_DEFAULT_EXPIRES_SEC=300
SIGNED_URL_MAX_EXPIRES_SEC=3600
GCS_SIGN_MODE=key

# ==========================================
# 9. RAG API 세부 설정
# ==========================================
RETRIEVER_VERSION=v1
GENERATOR_VERSION=v1
DEFAULT_TOP_K=8
MAX_TOP_K=20
RETRIEVER_TOPK_MULT=3
PER_DOC_CHUNK_CAP=2

# 트리 API 페이지 크기
TREE_PAGE_SIZE_DEFAULT=100
TREE_PAGE_SIZE_MAX=300
GRAPH_INIT_MAX_NODES=800
GRAPH_INIT_MAX_EDGES=1500
GRAPH_PRESET_VERSION=v1
